#!/bin/bash
# Launch an OMP agent against a local model, in a new pane.
#
#   spawn-model                 the first entry in models.conf
#   spawn-model ornith-35b      a specific one
#   spawn-model --list          what is available
#
# Meant to be called by Claude Code from inside the box: the user never has to
# touch the other pane or copy anything between them.
#
# Why a new pane rather than just `agent start`: each model lives on a different
# host, so each OMP agent needs its own LLAMA_CPP_BASE_URL. `herdr agent start`
# does NOT accept --env; `herdr pane split` does. So the environment goes on the
# pane and the agent inherits it when it starts there.
set -uo pipefail

REGISTRY="${MODELS_CONF:-/usr/local/share/agentic-box/models.conf}"

if [ ! -f "$REGISTRY" ]; then
    echo "ERROR: model registry not found at $REGISTRY" >&2
    exit 1
fi

# alias base_url ip, skipping comments and blank lines
entries() { grep -vE '^[[:space:]]*(#|$)' "$REGISTRY"; }

# Hostnames are deliberately not printed. They are in models.conf for whoever
# needs them, they are noise to the user, and keeping them out of stdout means a
# screen recording of this tool does not leak the topology of a private network.
# The failure path below does print the URL, because there it is the diagnosis.
list() {
    printf '%-14s %s\n' ALIAS STATUS
    while read -r alias url _ip; do
        if curl -sf -m 5 "$url/health" >/dev/null 2>&1; then
            status="up"
        else
            status="NOT RESPONDING"
        fi
        printf '%-14s %s\n' "$alias" "$status"
    done < <(entries)
}

case "${1:-}" in
    --list|-l|list)
        list
        exit 0
        ;;
    -h|--help)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
esac

ALIAS="${1:-$(entries | head -1 | awk '{print $1}')}"

ROW=$(entries | awk -v a="$ALIAS" '$1 == a')
if [ -z "$ROW" ]; then
    echo "ERROR: '$ALIAS' is not in $REGISTRY. Available:" >&2
    entries | awk '{print "  " $1}' >&2
    exit 1
fi

URL=$(awk '{print $2}' <<<"$ROW")

# If an agent by that name already exists, do not duplicate it: herdr would
# reject it, and two OMP agents against the same model add nothing.
if herdr agent list 2>/dev/null | grep -q "\"name\":\"${ALIAS}\""; then
    echo "'$ALIAS' is already running. To talk to it:"
    echo "  herdr agent prompt $ALIAS \"your instruction\""
    exit 0
fi

# Check BEFORE splitting the pane. If the server is down, OMP starts anyway and
# only fails on the first prompt — minutes later and much harder to diagnose.
if ! curl -sf -m 10 "$URL/health" >/dev/null 2>&1; then
    echo "ERROR: $URL/health is not responding. That model's server is down." >&2
    echo "       Do not try to start it yourself: it runs on another host you have" >&2
    echo "       no access to. Tell the user. See the llamacpp-compose project." >&2
    exit 1
fi

# The current pane is whichever one called this (Claude Code's).
CURRENT=$(herdr pane current | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["pane"]["pane_id"])')

# --env is the whole reason for this design. --no-focus leaves the focus where it
# was, so Claude Code stays usable while the other agent starts up.
NEW=$(herdr pane split "$CURRENT" --direction right --ratio 0.5 --no-focus \
      --env "LLAMA_CPP_BASE_URL=$URL" \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["pane"]["pane_id"])')

if [ -z "$NEW" ]; then
    echo "ERROR: could not create the pane" >&2
    exit 1
fi

# Name the pane. Without this they are all called "workspace": herdr titles a
# pane after the basename of its cwd, and the image's WORKDIR is
# /home/agentic/workspace, so Claude and every model would share one title and be
# indistinguishable on screen. There is no config key for this (`herdr config`
# only offers check and reset-keys) and no flag on `pane split`.
herdr pane rename "$NEW" "$ALIAS" >/dev/null 2>&1 || true

# OMP prepends the llama.cpp/ prefix; the alias has to match the llama-server
# --alias exactly. Verify with: curl $URL/v1/models
if herdr agent start "$ALIAS" --kind omp --pane "$NEW" -- --model "llama.cpp/$ALIAS" >/dev/null; then
    echo "ready: '$ALIAS' running in pane $NEW"
    echo "  herdr agent prompt $ALIAS \"your instruction\""
    echo "  herdr agent read   $ALIAS --source visible --lines 60"
    echo "  close-model $ALIAS"
else
    echo "ERROR: pane $NEW was created but OMP did not start in it." >&2
    echo "       See what happened with: herdr pane read $NEW --source visible" >&2
    exit 1
fi
