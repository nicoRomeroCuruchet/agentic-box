#!/bin/bash
# Shut down an OMP agent and close its pane.
#
#   close-model ornith-35b
#   close-model --all
#
# Closing the pane terminates the OMP process. The OMP session itself lives in
# the agentic-omp volume and survives, so bringing it back with spawn-model does
# not start from scratch.
set -uo pipefail

names() {
    herdr agent list 2>/dev/null \
        | python3 -c 'import json,sys
d=json.load(sys.stdin)
for a in d["result"]["agents"]:
    if a.get("agent") == "omp":
        print(a["name"], a["pane_id"])' 2>/dev/null
}

close_one() {
    local name="$1" pane="$2"
    if herdr pane close "$pane" >/dev/null 2>&1; then
        echo "closed: $name (pane $pane)"
    else
        echo "ERROR: could not close pane $pane for $name" >&2
        return 1
    fi
}

case "${1:-}" in
    --all|-a)
        found=0
        while read -r name pane; do
            [ -n "$name" ] || continue
            close_one "$name" "$pane"
            found=1
        done < <(names)
        [ "$found" = 1 ] || echo "no OMP agents were running"
        ;;
    ""|-h|--help)
        echo "usage: close-model <alias> | --all"
        echo
        echo "running now:"
        names | awk '{print "  " $1 "  (pane " $2 ")"}' || echo "  (none)"
        ;;
    *)
        PANE=$(names | awk -v n="$1" '$1 == n {print $2}')
        if [ -z "$PANE" ]; then
            echo "ERROR: no OMP agent named '$1'." >&2
            echo "running now:" >&2
            names | awk '{print "  " $1}' >&2
            exit 1
        fi
        close_one "$1" "$PANE"
        ;;
esac
