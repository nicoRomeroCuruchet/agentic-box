#!/bin/bash
# Baja un agente OMP y cierra su pane.
#
#   close-model ornith-35b
#   close-model --all
#
# Cerrar el pane termina el proceso de OMP. La sesion de OMP en si vive en el
# volumen agentic-omp y sobrevive, asi que volver a levantarlo con spawn-model
# no empieza de cero.
set -uo pipefail

nombres() {
    herdr agent list 2>/dev/null \
        | python3 -c 'import json,sys
d=json.load(sys.stdin)
for a in d["result"]["agents"]:
    if a.get("agent") == "omp":
        print(a["name"], a["pane_id"])' 2>/dev/null
}

cerrar() {
    local nombre="$1" pane="$2"
    if herdr pane close "$pane" >/dev/null 2>&1; then
        echo "cerrado: $nombre (pane $pane)"
    else
        echo "ERROR: no pude cerrar el pane $pane de $nombre" >&2
        return 1
    fi
}

case "${1:-}" in
    --all|-a)
        encontrado=0
        while read -r nombre pane; do
            [ -n "$nombre" ] || continue
            cerrar "$nombre" "$pane"
            encontrado=1
        done < <(nombres)
        [ "$encontrado" = 1 ] || echo "no habia ningun agente OMP levantado"
        ;;
    ""|-h|--help)
        echo "uso: close-model <alias> | --all"
        echo
        echo "levantados ahora:"
        nombres | awk '{print "  " $1 "  (pane " $2 ")"}' || echo "  (ninguno)"
        ;;
    *)
        PANE=$(nombres | awk -v n="$1" '$1 == n {print $2}')
        if [ -z "$PANE" ]; then
            echo "ERROR: no hay ningun agente OMP llamado '$1'." >&2
            echo "levantados ahora:" >&2
            nombres | awk '{print "  " $1}' >&2
            exit 1
        fi
        cerrar "$1" "$PANE"
        ;;
esac
