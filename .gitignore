# The agent binaries. NOT in the repo, for two reasons:
#
#   1. GitHub rejects files over 100 MB, and the Claude Code binary is ~300 MB
#      with omp at ~170.
#   2. They are already installed on the host; versioning them would store a
#      copy that goes stale on its own.
#
# deploy.sh copies them from the host's ~/.local/bin on every deploy.
bin/

# This installation's real configuration: tailnet hostnames and 100.x addresses.
# The versioned reference is models.conf.example.
models.conf

# Backups left behind by in-place edits. Git is the history, not these.
backup-*/
*.previous
*.pre-*
